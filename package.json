{
  "name": "@pipeshub-ai/mcp",
  "version": "4.10.0",
  "mcpName": "io.github.pipeshub-ai/mcp",
  "description": "PipesHub MCP: connect Claude Code, Codex, Cursor and other MCP clients to your company's permission-aware search and cited answers. Local stdio bridge to a PipesHub instance's remote /mcp endpoint, plus the pipeshub CLI.",
  "keywords": [
    "mcp",
    "mcp-server",
    "enterprise-search",
    "enterprise-rag",
    "context-layer",
    "claude-code",
    "codex",
    "cursor",
    "rag",
    "knowledge-base",
    "glean-alternative"
  ],
  "homepage": "https://docs.pipeshub.com/mcp/overview",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pipeshub-ai/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/pipeshub-ai/mcp-server/issues"
  },
  "license": "Apache-2.0",
  "author": "Pipeshub",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "@pipeshub-ai/mcp": "bin/mcp-server.js",
    "mcp": "bin/mcp-server.js",
    "pipeshub": "bin/pipeshub.js"
  },
  "scripts": {
    "build": "bun i && bun src/mcp-server/build.mts && tsc && tsc -p tsconfig.view.json",
    "mcpb:build": "bun i && bun src/mcp-server/build.mts --pack && tsc && tsc -p tsconfig.view.json",
    "check": "npm run lint",
    "lint": "eslint --cache --max-warnings=0 src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@stricli/core": "^1.1.2",
    "bun": "^1.2.12",
    "express": "^5.1.0",
    "nanoid": "^5.1.16",
    "zod": "^4.0.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.32.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^1.2.0",
    "@eslint/js": "^9.26.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@types/bun": "^1.2.13",
    "@types/express": "^5.0.1",
    "@types/node": "^18.19.3",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.17",
    "eslint": "^9.26.0",
    "globals": "^16.0.0",
    "pdfjs-dist": "^4.10.38",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
