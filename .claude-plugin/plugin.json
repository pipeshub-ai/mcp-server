{
  "name": "pipeshub",
  "version": "4.7.0",
  "description": "Permissioned search and cited answers over Slack, Drive, Gmail, Jira, Confluence, and 50+ workplace sources, from inside Claude Code.",
  "author": {
    "name": "PipesHub",
    "url": "https://www.pipeshub.com"
  },
  "homepage": "https://docs.pipeshub.com/for-agents",
  "repository": "https://github.com/pipeshub-ai/mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "pipeshub", "workplace-search", "rag", "knowledge"],
  "mcpServers": {
    "pipeshub": {
      "type": "http",
      "url": "${PIPESHUB_MCP_URL:-https://app.pipeshub.com/mcp}",
      "headers": {
        "Authorization": "Bearer ${PIPESHUB_MCP_TOKEN}",
        "X-PipesHub-Channel": "claude-code-plugin"
      }
    }
  }
}
