# Hand-maintained. Speakeasy regeneration must not touch these.
#
# On 2026-07-31 a regeneration pointed at a spec without the knowledge-graph
# endpoints ran against a sibling worktree and its orphan-cleanup step deleted
# the entire curated layer — every file below. Scope this list to all of it,
# not just the KG files.
#
# `src/mcp-server/tools/` has a trailing slash so it matches the directory
# only; `src/mcp-server/tools.ts` is the generated registry and stays
# regenerable.
#
# This checkout has no `.speakeasy/` directory, so this file is a forward guard
# here. Mirror it into whichever tree actually runs `speakeasy run` — that is
# where the deletions happen.

# Curated MCP surface: one tool per user intent, not one per operation.
src/mcp-server/tools/
src/mcp-server/server.ts
src/mcp-server/instructions.ts
src/mcp-server/prompts/
src/mcp-server/build.mts

# Hand-maintained funcs: streaming (SSE is unsupported by the generator) and
# the knowledge-graph endpoints (absent from the spec the generator reads).
src/funcs/agentsListAgents.ts
src/funcs/agentsStreamConversation.ts
src/funcs/agentsStreamMessage.ts
src/funcs/connectorGetRecordContent.ts
src/funcs/connectorLookupRecordByIdentifier.ts
src/funcs/connectorNavigateKnowledgeGraph.ts
src/funcs/conversationsStreamConversation.ts
src/funcs/conversationsStreamMessage.ts
src/funcs/recordsGetRecord.ts
src/funcs/recordsStreamRecordBuffer.ts

# Request-only trimmed models backing the above. The generated versions declare
# response unions pulling in ~10 further models; the funcs use `errorCodes: []`
# and the tools parse with `readJson`, so none of that is used.
src/models/agentops.ts
src/models/getrecordcontentop.ts
src/models/getrecordop.ts
src/models/lookuprecordbyidentifierop.ts
src/models/navigateknowledgegraphop.ts

# Hand-written hooks and lib helpers.
src/hooks/request-context.ts
src/hooks/requestid.ts
src/lib/dlv.ts
src/lib/is-plain-object.ts

__tests__/
