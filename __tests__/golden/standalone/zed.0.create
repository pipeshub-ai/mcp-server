{
  "context_servers": {
    "pipeshub": {
      "source": "custom",
      "command": "npx",
      "args": [
        "-y",
        "@pipeshub-ai/mcp@>=4.10.0",
        "start",
        "--server-url",
        "http://127.0.0.1:3000"
      ],
      "env": {
        "PIPESHUB_MCP_CHAT": "off"
      }
    }
  }
}
