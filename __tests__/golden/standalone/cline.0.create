{
  "mcpServers": {
    "pipeshub": {
      "command": "npx",
      "args": [
        "-y",
        "@pipeshub-ai/mcp@>=4.7.0",
        "start",
        "--server-url",
        "http://127.0.0.1:3000"
      ],
      "env": {
        "PIPESHUB_MCP_CHAT": "off"
      },
      "disabled": false,
      "autoApprove": []
    }
  }
}
